<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationId>app.desknest.desktop</ApplicationId>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Strings\*.json">
      <WithCulture>false</WithCulture>
      <Type>Non-Resx</Type>
      <LogicalName>DeskNest.App.Localization.Strings.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="../DeskNest.Core/DeskNest.Core.csproj" />
    <ProjectReference Include="../DeskNest.Platform/DeskNest.Platform.csproj" />
    <ProjectReference Include="../DeskNest.Inference/DeskNest.Inference.csproj" />
  </ItemGroup>
</Project>
