<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeskNest.App.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeskNest.App/Themes/DesignTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusPrimary}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
        </Style>
    </Application.Styles>
</Application>
