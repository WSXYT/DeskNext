<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeskNest.App.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeskNest.App/Themes/DesignTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ControlTheme x:Key="WorkspaceRowTheme" TargetType="ListBoxItem"
                          BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/></Style>
                <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource SelectionSurfaceBrush}"/></Style>
                <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource SelectionSurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Style>
                <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource SelectionSurfaceBrush}"/>
                </Style>
                <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/></Style>
                <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
            </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <Style Selector="Border.SettingsSection">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#187B68" />
                <ColorPaletteResources x:Key="Dark" Accent="#80D5BA" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>

        <Style Selector="Button.IconAction">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.IconAction PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.IconAction:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        </Style>
        <!-- Native Fluent controls with consistent corner radii. -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <!-- Window Chrome Control Buttons: Native Compact Windows Geometry -->
        <Style Selector="Button.WindowChromeButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.WindowChromeButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.WindowChromeButton:pressed">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        </Style>
        <Style Selector="Button.WindowChromeButton.CloseButton:pointerover">
            <Setter Property="Background" Value="#C42B1C" />
        </Style>
        <Style Selector="Button.WindowChromeButton.CloseButton:pointerover PathIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.WindowChromeButton.CloseButton:pressed">
            <Setter Property="Background" Value="#B22416" />
        </Style>
        <Style Selector="Button.WindowChromeButton.CloseButton:pressed PathIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Studio Navigation Rail Tabs -->
        <Style Selector="Button.StudioNavTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="Button.StudioNavTab:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.StudioNavTab:pressed">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        </Style>
        <Style Selector="Button.StudioNavTab.Active">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>

        <Style Selector="Button.StudioNavTab.NavRail">
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <!-- Segmented Filter Buttons -->
        <Style Selector="Button.SegmentButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.SegmentButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.SegmentButton.Active">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Context & File Action Buttons -->
        <Style Selector="Button.ActionButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.ActionButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        </Style>

        <!-- Primary Accent Buttons -->
        <Style Selector="Button.PrimaryAction">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryFgBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
        </Style>
        <Style Selector="Button.PrimaryAction:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <Style Selector="Button.PrimaryAction:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
        </Style>

        <!-- ListBox Items: Dense & Responsive Selection Feedback -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
        </Style>
    </Application.Styles>
</Application>