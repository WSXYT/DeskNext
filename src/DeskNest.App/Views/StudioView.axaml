<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeskNest.App.ViewModels"
             xmlns:views="using:DeskNest.App.Views"
             xmlns:loc="using:DeskNest.App.Localization"
             xmlns:th="using:DeskNest.App.Themes"
             xmlns:core="using:DeskNest.Core.Workspace"
             xmlns:flow="using:DeskNest.Core.Flow"
             x:Class="DeskNest.App.Views.StudioView"
             x:DataType="vm:StudioViewModel"
             KeyDown="OnWorkspaceKeyDown"
             Background="Transparent"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid ColumnDefinitions="244,*">
        <Border Grid.Column="0" Background="Transparent" Padding="12,16,12,18">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="6">
                    <Button  Classes="StudioNavTab NavRail" Classes.Active="{Binding IsSpacesTab}"
                            Command="{Binding SelectTabCommand}" CommandParameter="0"
                            ToolTip.Tip="{Binding Localizer[Nav.Spaces]}" AutomationProperties.Name="{Binding Localizer[Nav.Spaces]}">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="12">
                            <PathIcon Data="{StaticResource IconSpaces}" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Text="{Binding Localizer[Nav.Spaces]}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>
                    <Button  Classes="StudioNavTab NavRail" Classes.Active="{Binding IsTriageTab}"
                            Command="{Binding SelectTabCommand}" CommandParameter="1"
                            ToolTip.Tip="{Binding Localizer[Nav.Triage]}" AutomationProperties.Name="{Binding Localizer[Nav.Triage]}">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="12">
                            <PathIcon Data="{StaticResource IconInbox}" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Text="{Binding Localizer[Nav.Triage]}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>
                    <Button Name="WorkspaceSearchButton" Classes="StudioNavTab NavRail" Classes.Active="{Binding IsWorkspaceSearchTab}"
                            Click="OnWorkspaceSearchClick"
                            ToolTip.Tip="{Binding Localizer[Search.Workspace]}" AutomationProperties.Name="{Binding Localizer[Search.Workspace]}">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="12">
                            <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Text="{Binding Localizer[Search.Workspace]}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>
                    <Button Name="FlowDefinitionsButton" Classes="StudioNavTab NavRail" Classes.Active="{Binding IsFlowTab}"
                            Command="{Binding SelectTabCommand}" CommandParameter="6"
                            ToolTip.Tip="{Binding Localizer[Flow.Title]}" AutomationProperties.Name="{Binding Localizer[Flow.Title]}">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="12">
                            <PathIcon Data="{StaticResource IconSort}" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Text="{Binding Localizer[Flow.Title]}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>
                    <Button  Classes="StudioNavTab NavRail" Classes.Active="{Binding IsCapsuleTab}"
                            Command="{Binding SelectTabCommand}" CommandParameter="2"
                            ToolTip.Tip="{Binding Localizer[Capsule.Title]}" AutomationProperties.Name="{Binding Localizer[Capsule.Title]}">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="12">
                            <PathIcon Data="{StaticResource IconDeskNext}" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Text="{Binding Localizer[Capsule.Title]}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>
                </StackPanel>
                <!-- Left: Spaces Rail -->
                <Border Grid.Row="1" IsVisible="{Binding IsSpacesTab}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0,24,0,16">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Filter bar & Counters -->
                        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
                            <!-- Segmented Filter Control -->
                            <Border Grid.Row="0"
                                    Background="Transparent"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    BorderThickness="0" Padding="0">
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="SegmentButton" Classes.Active="{Binding IsAllFilter}" Margin="0,0,3,3"
                                            Content="{Binding Localizer[Spaces.FilterAll]}"
                                            Command="{Binding SetFilterCommand}" CommandParameter="All"/>
                                    <Button Classes="SegmentButton" Classes.Active="{Binding IsManagedFilter}" Margin="0,0,3,3"
                                            Content="{Binding Localizer[Spaces.FilterManaged]}"
                                            Command="{Binding SetFilterCommand}" CommandParameter="Managed"/>
                                    <Button Classes="SegmentButton" Classes.Active="{Binding IsMappedFilter}" Margin="0,0,3,3"
                                            Content="{Binding Localizer[Spaces.FilterMapped]}"
                                            Command="{Binding SetFilterCommand}" CommandParameter="Mapped"/>
                                </WrapPanel>
                            </Border>

                            <!-- Space Count Summaries -->
                            <StackPanel Grid.Row="1" IsVisible="False" Orientation="Horizontal" Spacing="12" Margin="2,6,0,0">
                                <TextBlock Text="{Binding ManagedSpacesCountText}"
                                           FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <TextBlock Text="{Binding MappedSpacesCountText}"
                                           FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Spaces List -->
                        <ListBox Name="SpacesListBox" Grid.Row="1" ItemContainerTheme="{StaticResource WorkspaceRowTheme}"
                                 ItemsSource="{Binding FilteredSpaces}"
                                 SelectedItem="{Binding SelectedSpace}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpaceItemViewModel">
                                    <Border Classes="SpaceCard"
                                            Margin="0,0,0,2"
                                            CornerRadius="{DynamicResource RadiusPrimary}"
                                            Padding="10,9">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Name="EditSpaceMenuItem"
                                                          Header="{Binding #SpacesListBox.((vm:StudioViewModel)DataContext).Localizer[Spaces.EditDetails]}"
                                                          Command="{Binding #SpacesListBox.((vm:StudioViewModel)DataContext).OpenEditSpaceCommand}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <views:FileIcon Grid.Column="0" FileName="folder" IsDirectory="True" CustomIconPath="{Binding CustomIconPath}"
                                                            Width="22" Height="22" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Normal" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ModeLocalized}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ItemCountText}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="2" Classes="ActionButton" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Margin="0,12,0,0" Padding="12,8"
                                Command="{Binding OpenAddSpaceDialogCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14"/>
                                <TextBlock Text="{Binding Localizer[Spaces.AddSpace]}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Spacing="6">
                    <Button  Classes="StudioNavTab NavRail" Classes.Active="{Binding IsSettingsTab}"
                            Command="{Binding SelectTabCommand}" CommandParameter="3"
                            ToolTip.Tip="{Binding Localizer[Nav.Settings]}" AutomationProperties.Name="{Binding Localizer[Nav.Settings]}">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="12">
                            <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Text="{Binding Localizer[Nav.Settings]}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>
                    <Button  Classes="StudioNavTab NavRail" Classes.Active="{Binding IsProbeTab}"
                            Command="{Binding SelectTabCommand}" CommandParameter="4"
                            ToolTip.Tip="{Binding Localizer[Nav.Probe]}" AutomationProperties.Name="{Binding Localizer[Nav.Probe]}">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="12">
                            <PathIcon Data="{StaticResource IconAlert}" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Text="{Binding Localizer[Nav.Probe]}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Height="60" Background="Transparent" Padding="20,0,22,0"
                    IsVisible="{Binding !IsSpacesTab}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Localizer[Nav.Spaces]}" IsVisible="{Binding IsSpacesTab}"
                               FontSize="20" FontWeight="Normal" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Localizer[Nav.Triage]}" IsVisible="{Binding IsTriageTab}"
                               FontSize="20" FontWeight="Normal" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Classes="IconAction" Click="OnOpenDropCapsuleClick"
                                ToolTip.Tip="{Binding Localizer[Capsule.Title]}" AutomationProperties.Name="{Binding Localizer[Capsule.Title]}">
                            <PathIcon Data="{StaticResource IconDeskNext}" Width="18" Height="18"/>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">

            <!-- ================= TAB 0: SPACES WORKSPACE ================= -->
            <Grid IsVisible="{Binding IsSpacesTab}">
                <!-- Right: Selected Space Detail & Open Catalog Canvas -->
                <Border x:Name="SpaceDetailSurface"
                        DragDrop.AllowDrop="True"
                        Background="{DynamicResource ContentSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="6,0,0,0" Margin="4,0,0,0"
                        Padding="28,28,24,20">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                        <!-- Space Header Info -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding SelectedSpace.Name}" FontSize="20" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" IsVisible="False" Margin="8,0,0,0" CornerRadius="3"
                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedSpace.ModeLocalized}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding SelectedSpace.Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6">
                                <Button Name="OpenSpaceWindowButton" Classes="IconAction" HorizontalAlignment="Right"
                                        Click="OnOpenSpaceWindowClick"
                                        ToolTip.Tip="{Binding Localizer[Spaces.OpenWindow]}"
                                        AutomationProperties.Name="{Binding Localizer[Spaces.OpenWindow]}">
                                    <PathIcon Data="{StaticResource IconWindow}" Width="16" Height="16"/>
                                </Button>
                                <Button Name="CatalogSpaceButton" Classes="ActionButton" HorizontalAlignment="Stretch"
                                        Content="{Binding Localizer[Spaces.CatalogFolder]}"
                                        ToolTip.Tip="{Binding Localizer[Spaces.CatalogFolderHint]}"
                                        IsVisible="{Binding SelectedSpace.IsMapped}" Command="{Binding CatalogSpaceCommand}"/>
                            </StackPanel>
                        </Grid>

                         <!-- Path is secondary metadata, not a banner across the canvas. -->
                         <TextBlock Grid.Row="1" IsVisible="False" Text="{Binding SelectedSpace.Folder}"
                                    FontSize="11" FlowDirection="LeftToRight"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{DynamicResource TextTertiaryBrush}"
                                    ToolTip.Tip="{Binding SelectedSpace.Folder}"
                                    Margin="0,9,0,13"/>

                        <!-- Drop Target Banner & Status Notice -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,8" Spacing="6">
                            <!-- Visual target state banner when dragged over -->
                            <Border x:Name="SpaceDropActiveBanner"
                                    IsVisible="{Binding IsDragOverSpaceSurface}"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    BorderBrush="{DynamicResource AccentPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusPrimary}"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14"
                                              Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Localizer[Drop.SpaceTargetHint]}"
                                               FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Status Notice for dropped or unsupported files -->
                            <TextBlock Text="{Binding SpaceDropNotice}"
                                       IsVisible="{Binding HasSpaceDropNotice}"
                                       FontSize="11" Foreground="{DynamicResource AccentTextBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,6">
                            <TextBox Name="FileSearchInput" Text="{Binding FileSearchText}" MaxLength="260"
                                     Height="36" Padding="12,6" Margin="0,0,12,0"
                                     PlaceholderText="{Binding Localizer[Files.SearchName]}"
                                     AutomationProperties.Name="{Binding Localizer[Files.SearchName]}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Classes="IconAction" Command="{Binding ExecutePreviewFileCommand}"
                                        CommandParameter="{Binding SelectedFile}" IsEnabled="{Binding CanPreviewFile}"
                                        ToolTip.Tip="{Binding Localizer[Files.ActionPreview]}"
                                        AutomationProperties.Name="{Binding Localizer[Files.ActionPreview]}">
                                    <PathIcon Data="{StaticResource IconPreview}" Width="18" Height="18"/>
                                </Button>
                                <Button Classes="IconAction" Command="{Binding ExecuteCopyFileCommand}"
                                        CommandParameter="{Binding SelectedFile}" IsEnabled="{Binding CanCopyFile}"
                                        ToolTip.Tip="{Binding Localizer[Files.ActionCopy]}"
                                        AutomationProperties.Name="{Binding Localizer[Files.ActionCopy]}">
                                    <PathIcon Data="{StaticResource IconCopy}" Width="18" Height="18"/>
                                </Button>
                                <Button Classes="IconAction" Command="{Binding ExecutePasteFileCommand}"
                                        CommandParameter="{Binding SelectedSpace}" IsEnabled="{Binding CanPasteFile}"
                                        ToolTip.Tip="{Binding Localizer[Files.ActionPaste]}"
                                        AutomationProperties.Name="{Binding Localizer[Files.ActionPaste]}">
                                    <PathIcon Data="{StaticResource IconInbox}" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,4,0,8">
                            <TextBlock Text="{Binding SelectedSpace.ItemCountText}" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            <ToggleButton Name="FilesDescending" Grid.Column="1" IsChecked="{Binding SortFilesDescending}"
                                          Width="28" Height="28" MinHeight="0" Padding="6" BorderThickness="0"
                                          Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                          ToolTip.Tip="{Binding Localizer[Files.SortDescending]}"
                                          AutomationProperties.Name="{Binding Localizer[Files.SortDescending]}">
                                <PathIcon Data="{StaticResource IconSort}" Width="14" Height="14"/>
                            </ToggleButton>
                        </Grid>
                        <!-- Virtualized File List or Empty State -->
                        <Grid Grid.Row="5">
                            <TextBlock Text="{Binding Localizer[Files.NoMatches]}" IsVisible="{Binding NoMatchingFiles}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <!-- Empty State: Visible only when space is empty -->
                            <Border IsVisible="{Binding SelectedSpace.IsEmpty}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusPrimary}"
                                    Padding="32,24"
                                    MaxWidth="500">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="{DynamicResource RadiusSmall}"
                                            Background="{DynamicResource SurfaceSubtleBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconFolder}"
                                                  Width="16" Height="16"
                                                  Foreground="{DynamicResource AccentPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Localizer[Spaces.EmptyFiles]}"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                               MaxWidth="440"/>
                                </StackPanel>
                            </Border>

                            <!-- Virtualizing ListBox for File Metadata: Optimized for Scanning -->
                            <ListBox x:Name="FilesListBox" ItemContainerTheme="{StaticResource WorkspaceRowTheme}"
                                     ItemsSource="{Binding VisibleFiles}"
                                     SelectedItem="{Binding SelectedFile}"
                                     IsVisible="{Binding SelectedSpace.HasFiles}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding ExecuteOpenFileCommand}"
                                                CommandParameter="{Binding SelectedFile}"/>
                                </ListBox.KeyBindings>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkspaceFileItemViewModel">
                                        <Border Classes="FileRowCard"
                                                DoubleTapped="OnFileDoubleTapped"
                                                Margin="0,0,0,1"
                                                CornerRadius="{DynamicResource RadiusSmall}"
                                                Padding="12,3"
                                                ToolTip.Tip="{Binding Path}">
                                            <Border.ContextMenu>
                                                <ContextMenu Opened="OnFileMenuOpened">
                                                    <MenuItem Header="{Binding Localizer[Files.ActionOpen]}"
                                                              Command="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).ExecuteOpenFileCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsEnabled="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).CanOpenFile}"/>
                                                    <MenuItem Header="{Binding Localizer[Files.ActionReveal]}"
                                                              Command="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).ExecuteRevealFileCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsEnabled="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).CanRevealFile}"/>
                                                    <MenuItem Header="{Binding Localizer[Files.ActionPreview]}"
                                                              Command="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).ExecutePreviewFileCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsEnabled="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).CanPreviewFile}"/>
                                                    <MenuItem Name="ClassificationPreviewMenu" Header="{Binding Localizer[Classification.Action]}"
                                                              Command="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).PreviewClassificationCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="{Binding Localizer[Action.Cancel]}"
                                                              Command="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).PreviewClassificationCancelCommand}"
                                                              IsVisible="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).PreviewClassificationCommand.IsRunning}"/>
                                                    <Separator/>
                                                    <MenuItem Name="MoveToSpaceMenu" Header="{Binding Localizer[Files.ActionMoveToSpace]}"/>
                                                    <MenuItem Name="UndoFileMenu" Header="{Binding Localizer[Operations.UndoAction]}" IsVisible="False"/>
                                                    <MenuItem Header="{Binding Localizer[Files.ActionCut]}"
                                                              InputGesture="{OnPlatform Default='Ctrl+X', macOS='Meta+X'}"
                                                              Command="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).ExecuteCutFileCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsEnabled="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).CanCutFile}"/>
                                                    <MenuItem Header="{Binding Localizer[Files.ActionCopy]}" InputGesture="{OnPlatform Default='Ctrl+C', macOS='Meta+C'}"
                                                              Command="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).ExecuteCopyFileCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsEnabled="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).CanCopyFile}"/>
                                                    <MenuItem Header="{Binding Localizer[Files.ActionPaste]}"
                                                              InputGesture="{OnPlatform Default='Ctrl+V', macOS='Meta+V'}"
                                                              Command="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).ExecutePasteFileCommand}"
                                                              CommandParameter="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).SelectedSpace}"
                                                              IsEnabled="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).CanPasteFile}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{Binding Localizer[Files.ActionRename]}"
                                                              InputGesture="F2"
                                                              Command="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).OpenRenameDialogCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsEnabled="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).CanRenameFile}"/>
                                                    <MenuItem Header="{Binding DeleteActionText}"
                                                              InputGesture="Delete"
                                                              Command="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).ExecuteDeleteFileCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsEnabled="{Binding #FilesListBox.((vm:StudioViewModel)DataContext).CanDeleteFile}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <views:FileIcon Grid.Column="0" FileName="{Binding Name}" IsDirectory="{Binding IsDirectory}" CustomIconPath="{Binding CustomIconPath}"
                                                                Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           FontWeight="Normal" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ExtensionLabel}" MaxWidth="68" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding CapabilityDescription}"
                                                           Margin="16,0,0,0" FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= TAB 1: TRIAGE DRAWER ================= -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsTriageTab}" Margin="28,8,24,20">
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Localizer[Triage.Title]}" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- Empty Triage State -->
                    <Border IsVisible="{Binding !HasPendingItems}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="3"
                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1">
                                <PathIcon Data="{StaticResource IconCheck}"
                                          Width="12" Height="12"
                                          Foreground="{DynamicResource SuccessBadgeFgBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Localizer[Triage.Empty]}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Pending Items List -->
                    <ListBox ItemsSource="{Binding PendingItems}" ItemContainerTheme="{StaticResource WorkspaceRowTheme}"
                             SelectedItem="{Binding SelectedPendingItem}"
                             IsVisible="{Binding HasPendingItems}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PendingItemViewModel">
                                <Border Margin="0,0,0,10"
                                        Background="{DynamicResource ContentSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusPrimary}"
                                        Padding="20,18">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                        <!-- Header: Name & Reason Badge -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" FontSize="15"
                                                       Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1"
                                                    CornerRadius="{DynamicResource RadiusSmall}"
                                                    Background="{DynamicResource WarningBadgeBgBrush}"
                                                    Padding="6,2">
                                                <TextBlock Text="{Binding ReasonLocalized}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource WarningBadgeFgBrush}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Path & Time -->
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                                            <TextBlock Grid.Column="0" Text="{Binding Path}"
                                                       FontSize="12" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                                                       FlowDirection="LeftToRight" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <ToolTip.Tip><TextBlock Text="{Binding Path}" FlowDirection="LeftToRight"/></ToolTip.Tip>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedSeenAt}"
                                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>

                                        <!-- Resolution Feedback if any -->
                                        <StackPanel Grid.Row="2" Spacing="4" Margin="0,6,0,0">
                                            <TextBox Name="PendingClassificationHint" Text="{Binding ClassificationHint}" MaxLength="256"
                                                     PlaceholderText="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).Localizer[Classification.Hint]}"
                                                     AutomationProperties.Name="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).Localizer[Classification.Hint]}"/>
                                            <TextBlock Text="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).Localizer[Classification.HintNotice]}"
                                                       FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ResolutionNotice}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11"/>
                                        </StackPanel>

                                        <!-- Action Buttons Bar with Space Selector -->
                                        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                                            <WrapPanel.Styles>
                                                <Style Selector="Button">
                                                    <Setter Property="Margin" Value="6,0,0,4"/>
                                                </Style>
                                            </WrapPanel.Styles>
                                            <!-- Target space selector -->
                                            <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).AllSpaces}"
                                                      SelectedItem="{Binding TargetSpace}"
                                                      PlaceholderText="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).Localizer[Triage.SelectTargetPrompt]}"
                                                      Width="180"
                                                      CornerRadius="{DynamicResource RadiusSmall}"
                                                      FontSize="11"
                                                      Height="28">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SpaceItemViewModel">
                                                        <TextBlock Text="{Binding Name}" FontSize="11"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <Button Name="PendingFilePreviewButton" Classes="ActionButton" Margin="6,0,0,4"
                                                    Content="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).Localizer[Files.ActionPreview]}"
                                                    Command="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).PreviewPendingFileCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Name="PendingClassificationButton" Classes="ActionButton" Margin="6,0,0,4"
                                                    Content="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).Localizer[Classification.Action]}"
                                                    Command="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).PreviewClassificationCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Classes="ActionButton" Margin="6,0,0,4" Content="{Binding ClassificationTarget.Name}"
                                                    IsVisible="{Binding HasClassificationTarget}"
                                                    ToolTip.Tip="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).Localizer[Triage.SelectTargetPrompt]}"
                                                    Command="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).UseClassificationTargetCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Classes="ActionButton" Margin="6,0,0,4"
                                                    Content="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).Localizer[Action.Cancel]}"
                                                    IsVisible="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).PreviewClassificationCommand.IsRunning}"
                                                    Command="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).PreviewClassificationCancelCommand}"/>

                                            <!-- Assign Button -->
                                            <Button Classes="PrimaryAction"
                                                    Name="ImportPendingButton"
                                                    Content="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).Localizer[Triage.ImportAction]}"
                                                    Command="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).OpenImportConfirmationCommand}"
                                                    CommandParameter="{Binding}"/>

                                            <!-- Create Space Button -->
                                            <Button Classes="ActionButton"
                                                    Content="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).Localizer[Triage.ActionNewSpace]}"
                                                    Command="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).OpenCreateSpaceFromTriageCommand}"
                                                    CommandParameter="{Binding}"/>

                                            <!-- Dismiss Button -->
                                            <Button Classes="ActionButton"
                                                    Content="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).Localizer[Triage.ActionDismiss]}"
                                                    Command="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).DismissPendingItemCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- ================= TAB 2: DROP CAPSULE ================= -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsCapsuleTab}">
                <StackPanel Grid.Row="0" Spacing="16" MaxWidth="640" HorizontalAlignment="Center" Margin="0,32,0,0">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Localizer[Capsule.Title]}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Localizer[Capsule.Subtitle]}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Drop Capsule Card with Native Drop Capability -->
                    <Border x:Name="DropCapsuleBorder"
                            DragDrop.AllowDrop="True"
                            CornerRadius="{DynamicResource RadiusLarge}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="24">
                        <StackPanel Spacing="14">
                            <!-- Visual target state banner when dragged over -->
                            <Border IsVisible="{Binding IsDragOverCapsule}"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    BorderBrush="{DynamicResource AccentPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusPrimary}"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconFile}" Width="14" Height="14"
                                              Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Localizer[Drop.CapsuleTargetHint]}"
                                               FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding Localizer[Capsule.Instruction]}"
                                       IsVisible="{Binding !IsDragOverCapsule}"
                                       FontWeight="Medium" FontSize="13" HorizontalAlignment="Center"/>

                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding CapsuleInputPath}"
                                         PlaceholderText="{Binding Localizer[Capsule.Placeholder]}"
                                         CornerRadius="{DynamicResource RadiusSmall}"
                                         FontFamily="Consolas,Menlo,Monospace"
                                         FontSize="12"
                                         FlowDirection="LeftToRight"/>
                                <Button Grid.Column="2"
                                        Classes="PrimaryAction"
                                        Content="{Binding Localizer[Capsule.Submit]}"
                                        Command="{Binding SubmitCapsuleCommand}"
                                        Padding="14,6" FontSize="12"/>
                            </Grid>

                            <TextBlock Text="{Binding CapsuleNotice}"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Boundary Notice -->
                    <Border CornerRadius="{DynamicResource RadiusSmall}"
                            Background="{DynamicResource WarningBadgeBgBrush}"
                            Padding="12,8">
                        <TextBlock Text="{Binding Localizer[Capsule.Notice]}"
                                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource WarningBadgeFgBrush}"/>
                    </Border>

                    <!-- Launch Companion Window Banner -->
                    <Border CornerRadius="{DynamicResource RadiusSmall}"
                            Background="{DynamicResource SurfaceSubtleBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Localizer[Capsule.Title]}" FontWeight="SemiBold" FontSize="12"/>
                                    <Border CornerRadius="3" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Padding="4,1">
                                        <TextBlock Text="Desktop" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Localizer[Capsule.Subtitle]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="ActionButton"
                                    Content="{Binding Localizer[Action.Open]}"
                                    Click="OnOpenDropCapsuleClick"
                                    Padding="14,6" FontSize="11"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ================= TAB 3: SETTINGS ================= -->
            <ScrollViewer IsVisible="{Binding IsSettingsTab}" Classes="SettingsPage">
                <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch" Margin="32,12,32,28">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Localizer[Settings.Title]}" FontSize="20" FontWeight="Medium"/>
                    </StackPanel>



                    <Border Classes="SettingsSection">
                        <StackPanel Spacing="24">
                    <!-- Section: General -->
                    <StackPanel Spacing="16">
                        <TextBlock Text="{Binding Localizer[Settings.General]}" FontWeight="SemiBold" FontSize="16"/>
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="{Binding Localizer[Language.Label]}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding SupportedLanguages}"
                                          SelectedItem="{Binding SettingsLanguage}"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="{DynamicResource RadiusSmall}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="loc:LanguageInfo">
                                            <TextBlock Text="{Binding DisplayText}" FontSize="14"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="8">
                                <TextBlock Text="{Binding Localizer[Theme.Label]}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding SupportedThemes}"
                                          SelectedItem="{Binding SettingsTheme}"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="{DynamicResource RadiusSmall}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="th:AppThemeMode">
                                            <TextBlock Text="{Binding}" FontSize="14"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Localizer[Theme.Accent]}" FontSize="16" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Localizer[Theme.AccentHint]}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <WrapPanel>
                            <RadioButton Name="ManualAccentMode" GroupName="AccentSource" Margin="0,0,16,8"
                                         Content="{Binding Localizer[Theme.AccentManual]}" IsChecked="{Binding IsManualAccent}"/>
                            <RadioButton Name="WindowsAccentMode" GroupName="AccentSource" Margin="0,0,16,8"
                                         Content="{Binding Localizer[Theme.AccentWindows]}" IsChecked="{Binding IsWindowsAccent}"
                                         IsEnabled="{Binding CanFollowWindowsAppearance}"/>
                            <RadioButton Name="WallpaperAccentMode" GroupName="AccentSource" Margin="0,0,0,8"
                                         Content="{Binding Localizer[Theme.AccentWallpaper]}" IsChecked="{Binding IsWallpaperAccent}"
                                         IsEnabled="{Binding CanFollowWindowsAppearance}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Localizer[Theme.AccentAutoHint]}" IsVisible="{Binding !IsManualAccent}"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding AccentPresets}" IsEnabled="{Binding IsManualAccent}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Width="28" Height="28" Margin="0,0,8,0" CornerRadius="4"
                                            Background="{Binding}" ToolTip.Tip="{Binding}" AutomationProperties.Name="{Binding}"
                                            Command="{Binding $parent[ItemsControl].((vm:StudioViewModel)DataContext).SelectAccentCommand}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ColorPicker Name="CustomAccentPicker" Color="{Binding CustomAccent, Mode=TwoWay}"
                                         IsEnabled="{Binding IsManualAccent}" ColorSpectrumShape="Ring" IsColorSpectrumVisible="True"
                                         IsAlphaEnabled="False" IsAlphaVisible="False"
                                         IsColorPaletteVisible="False" IsColorModelVisible="True"
                                         IsColorComponentsVisible="True" IsHexInputVisible="True"
                                         ToolTip.Tip="{Binding Localizer[Theme.Accent]}"
                                         AutomationProperties.Name="{Binding Localizer[Theme.Accent]}"/>
                            <TextBox Name="AccentColorInput" Width="144" MaxLength="7" Text="{Binding SettingsAccentColor}" IsEnabled="{Binding IsManualAccent}"
                                     PlaceholderText="#RRGGBB" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Localizer[Theme.Accent]}"/>
                            <Button Content="{Binding Localizer[Theme.AccentDefault]}" Command="{Binding SelectAccentCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"/>

                    <!-- Section: Engine -->
                    <StackPanel Spacing="16">
                        <TextBlock Text="{Binding Localizer[Settings.Engine]}" FontWeight="SemiBold" FontSize="16"/>
                        <WrapPanel>
                            <RadioButton Name="LayaPreviewProvider" GroupName="PreviewProvider" Margin="0,0,16,0"
                                         Content="{Binding Localizer[Classification.LocalCpu]}" IsChecked="{Binding IsLayaPreview, Mode=TwoWay}"/>
                            <RadioButton Name="JevPreviewProvider" GroupName="PreviewProvider"
                                         Content="{Binding Localizer[Classification.JevCloud]}" IsChecked="{Binding IsJevPreview, Mode=TwoWay}"/>
                        </WrapPanel>
                        <StackPanel Spacing="8" IsVisible="{Binding IsJevPreview}">
                            <TextBlock Text="{Binding Localizer[Classification.JevSetup]}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Localizer[Classification.SessionKey]}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Name="JevSessionKeyInput" Text="{Binding JevSessionKey, Mode=TwoWay}"
                                         PasswordChar="●" MaxLength="4096" FlowDirection="LeftToRight"
                                         AutomationProperties.Name="{Binding Localizer[Classification.SessionKey]}"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding Localizer[Classification.ClearSession]}"
                                        Command="{Binding ClearJevSessionCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding Localizer[Classification.CredentialNotice]}" TextWrapping="Wrap"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <WrapPanel IsVisible="{Binding CanStoreJevCredential}">
                                <Button Name="SaveJevKeyButton" Content="{Binding Localizer[Classification.SaveKey]}"
                                        Command="{Binding ManageJevCredentialCommand}" CommandParameter="save" Margin="0,0,6,6"/>
                                <Button Name="LoadJevKeyButton" Content="{Binding Localizer[Classification.LoadKey]}"
                                        Command="{Binding ManageJevCredentialCommand}" CommandParameter="load" Margin="0,0,6,6"/>
                                <Button Name="DeleteJevKeyButton" Content="{Binding Localizer[Classification.DeleteKey]}"
                                        Command="{Binding ManageJevCredentialCommand}" CommandParameter="delete" Margin="0,0,6,6"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding JevCredentialNotice}" TextWrapping="Wrap" FontSize="13"/>
                            <CheckBox Name="JevSendConsent" IsChecked="{Binding JevSendConsent, Mode=TwoWay}">
                                <TextBlock Text="{Binding Localizer[Classification.JevConsent]}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <WrapPanel>
                                <Button Name="TestJevConnectionButton" Content="{Binding Localizer[Classification.TestJev]}"
                                        Command="{Binding CheckJevConnectionCommand}" Margin="0,0,8,0"/>
                                <Button Content="{Binding Localizer[Action.Cancel]}" Command="{Binding CheckJevConnectionCancelCommand}"
                                        IsVisible="{Binding CheckJevConnectionCommand.IsRunning}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Localizer[Classification.TestJevNotice]}" TextWrapping="Wrap" FontSize="12"/>
                            <TextBlock Text="{Binding JevConnectionNotice}" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Spacing="8" IsVisible="{Binding IsLayaPreview}">
                            <TextBlock Text="{Binding Localizer[OOBE.Step2.ModelCache]}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Localizer[Classification.Setup]}" TextWrapping="Wrap"
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Name="ModelFolderInput" Text="{Binding SettingsModelCache}"
                                         CornerRadius="{DynamicResource RadiusSmall}"
                                         FontFamily="Consolas,Menlo,Monospace" FontSize="13" FlowDirection="LeftToRight"
                                         AutomationProperties.Name="{Binding Localizer[OOBE.Step2.ModelCache]}"/>
                                <Button Name="BrowseModelFolderButton" Grid.Column="1" Margin="8,0,0,0"
                                        Content="{Binding Localizer[Action.Browse]}" Click="OnBrowseModelFolderClick"
                                        ToolTip.Tip="{Binding Localizer[Classification.Setup]}"/>
                            </Grid>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Name="VerifyLocalModelButton" Classes="ActionButton" Margin="0,0,8,0"
                                        Content="{Binding Localizer[Classification.VerifyBundle]}" Command="{Binding VerifyLocalModelCommand}"/>
                                <Button Name="CancelModelVerificationButton" Classes="ActionButton"
                                        Content="{Binding Localizer[Action.Cancel]}"
                                        IsVisible="{Binding VerifyLocalModelCommand.IsRunning}"
                                        Command="{Binding VerifyLocalModelCancelCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ModelVerificationNotice}" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Localizer[Classification.InstallLocation]}" FontSize="13"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Name="ModelInstallLocationInput" Text="{Binding ModelInstallRoot}" IsReadOnly="True" FlowDirection="LeftToRight"/>
                                <Button Name="BrowseModelInstallLocationButton" Grid.Column="1" Margin="8,0,0,0"
                                        Content="{Binding Localizer[Action.Browse]}" Click="OnBrowseModelInstallLocation"/>
                            </Grid>
                            <TextBlock Text="{Binding Localizer[Classification.InstallLocationNotice]}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <WrapPanel>
                                <Button Name="DownloadModelPackageButton" Classes="PrimaryAction" Margin="0,0,8,0"
                                        Content="{Binding Localizer[Classification.DownloadPackage]}"
                                        ToolTip.Tip="{Binding Localizer[Classification.DownloadPackageNotice]}"
                                        Command="{Binding InstallLocalModelPackageCommand}"/>
                                <Button Name="ImportModelPackageButton" Classes="ActionButton" Margin="0,0,8,0"
                                        Content="{Binding Localizer[Classification.ImportPackage]}" Click="OnImportModelPackageClick"/>
                                <Button Name="RepairModelPackageButton" Classes="ActionButton" Margin="0,0,8,0"
                                        Content="{Binding Localizer[Classification.RepairPackage]}"
                                        ToolTip.Tip="{Binding Localizer[Classification.RepairPackageNotice]}"
                                        Command="{Binding InstallLocalModelPackageCommand}"/>
                                <Button Name="RemoveModelDataButton" Classes="ActionButton" Margin="0,0,8,0"
                                        Content="{Binding Localizer[Classification.RemoveModelData]}"
                                        Command="{Binding OpenModelRemovalCommand}" IsEnabled="{Binding !IsModelRemovalBusy}"/>
                                <Button Name="CancelModelInstallButton" Classes="ActionButton"
                                        Content="{Binding Localizer[Action.Cancel]}"
                                        IsVisible="{Binding InstallLocalModelPackageCommand.IsRunning}"
                                        Command="{Binding InstallLocalModelPackageCancelCommand}"/>
                            </WrapPanel>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ModelInstallProgress}"
                                         IsVisible="{Binding InstallLocalModelPackageCommand.IsRunning}"/>
                            <TextBlock Text="{Binding ModelInstallNotice}" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"/>

                    <!-- Section: Storage & Monitoring -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Localizer[Settings.Storage]}" FontWeight="SemiBold" FontSize="16"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Localizer[OOBE.Step4.ManagedRootLabel]}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding SettingsManagedRoot}"
                                     CornerRadius="{DynamicResource RadiusSmall}"
                                     FontFamily="Consolas,Menlo,Monospace"
                                     FontSize="13"
                                     FlowDirection="LeftToRight"/>
                            <TextBlock Text="{Binding Localizer[Settings.ManagedRootNotice]}"
                                       TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Monitored list -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Localizer[OOBE.Step4.MonitoredLabel]}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid ColumnDefinitions="*,8,Auto,Auto">
                                <Button Grid.Column="3" Content="{Binding Localizer[Action.Browse]}" Click="OnBrowseObservationFoldersClick" Margin="6,0,0,0"/>
                                <TextBox Grid.Column="0" Text="{Binding NewSettingsMonitoredFolder}"
                                         FontFamily="Consolas,Menlo,Monospace" FlowDirection="LeftToRight"
                                         FontSize="13"
                                         CornerRadius="{DynamicResource RadiusSmall}"/>
                                <Button Grid.Column="2" Classes="ActionButton" Content="{Binding Localizer[Action.Add]}" Command="{Binding AddSettingsMonitoredFolderCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SettingsMonitoredFolders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding}"
                                                       FontFamily="Consolas,Menlo,Monospace" FontSize="13" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Classes="ActionButton" Content="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).Localizer[Action.Delete]}"
                                                    Command="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).RemoveSettingsMonitoredFolderCommand}"
                                                    CommandParameter="{Binding}" Padding="6,1" FontSize="13"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Excluded list -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Localizer[OOBE.Step4.ExcludedLabel]}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid ColumnDefinitions="*,8,Auto,Auto">
                                <Button Grid.Column="3" Content="{Binding Localizer[Action.Browse]}" Click="OnBrowseObservationFoldersClick" Tag="excluded" Margin="6,0,0,0"/>
                                <TextBox Grid.Column="0" Text="{Binding NewSettingsExcludedFolder}"
                                         FontFamily="Consolas,Menlo,Monospace" FlowDirection="LeftToRight"
                                         FontSize="13"
                                         CornerRadius="{DynamicResource RadiusSmall}"/>
                                <Button Grid.Column="2" Classes="ActionButton" Content="{Binding Localizer[Action.Add]}" Command="{Binding AddSettingsExcludedFolderCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SettingsExcludedFolders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding}"
                                                       FontFamily="Consolas,Menlo,Monospace" FontSize="13" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Classes="ActionButton" Content="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).Localizer[Action.Delete]}"
                                                    Command="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).RemoveSettingsExcludedFolderCommand}"
                                                    CommandParameter="{Binding}" Padding="6,1" FontSize="13"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Explicit session observation: pending metadata only, no automatic moves. -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Localizer[Observation.Notice]}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="StartFolderObservationButton" Content="{Binding Localizer[Observation.Start]}"
                                        Command="{Binding StartFolderObservationCommand}" IsEnabled="{Binding !IsFolderObservationActive}"/>
                                <Button Content="{Binding Localizer[Observation.Stop]}" Command="{Binding StopFolderObservationCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding FolderObservationNotice}" TextWrapping="Wrap" FontSize="14"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Name="ScanObservedFoldersButton" Content="{Binding Localizer[Observation.Scan]}"
                                        Command="{Binding ScanObservedFoldersCommand}"/>
                                <Button Content="{Binding Localizer[Action.Cancel]}" Command="{Binding ScanObservedFoldersCancelCommand}"
                                        IsVisible="{Binding ScanObservedFoldersCommand.IsRunning}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding FolderScanNotice}" TextWrapping="Wrap" FontSize="14"/>
                            <TextBlock Text="{Binding Localizer[Observation.TargetNotice]}" TextWrapping="Wrap" FontSize="14"/>
                            <ComboBox Name="ObservationSourcePicker" ItemsSource="{Binding ObservationSources}"
                                      SelectedItem="{Binding ObservationSourcePath}" HorizontalAlignment="Stretch"
                                      FlowDirection="LeftToRight"/>
                            <TextBlock Text="{Binding ObservationSourceStatus}" TextWrapping="Wrap" FontSize="14"/>
                            <WrapPanel IsEnabled="{Binding !IsChangingObservationSource}">
                                <Button Name="PauseObservationSourceButton" Content="{Binding Localizer[Observation.PauseSource]}"
                                        Command="{Binding PauseObservationSourceCommand}" Margin="0,0,8,4"/>
                                <Button Name="ResumeObservationSourceButton" Content="{Binding Localizer[Observation.ResumeSource]}"
                                        Command="{Binding ResumeObservationSourceCommand}" Margin="0,0,0,4"/>
                            </WrapPanel>
                            <ComboBox Name="ObservationTargetPicker" ItemsSource="{Binding AllSpaces}"
                                      SelectedItem="{Binding ObservationTargetSpace}" HorizontalAlignment="Stretch"
                                      PlaceholderText="{Binding Localizer[Triage.SelectTargetPrompt]}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Name="BindObservationTargetButton" Content="{Binding Localizer[Triage.ActionAssign]}"
                                        Command="{Binding BindObservationTargetCommand}"/>
                                <Button Content="{Binding Localizer[Observation.ClearTarget]}" Command="{Binding ClearObservationTargetCommand}"/>
                            </StackPanel>
                        </StackPanel>


                    </StackPanel>


                    <Border Classes="SettingsSection">
                        <StackPanel Spacing="24">
                        </StackPanel>
                    </Border>

                    <!-- Section: Operation History & Transaction Audit Log (P3) -->
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Localizer[Operations.Title]}" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="{Binding Localizer[Operations.Subtitle]}"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OperationHistoryCount, StringFormat='{}{0}'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Manual Move Gated Notice / Boundary Status -->
                        <Border CornerRadius="{DynamicResource RadiusSmall}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                         Fill="{DynamicResource AccentPrimaryBrush}"/>
                                <TextBlock Text="{Binding ManualMoveStatusNotice}"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Manual Undo Gated Notice / Boundary Status -->
                        <Border CornerRadius="{DynamicResource RadiusSmall}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                         Fill="{DynamicResource AccentPrimaryBrush}"/>
                                <TextBlock Text="{Binding ManualUndoStatusNotice}"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Immutable Audit Log & No Undo Notice -->
                        <Border CornerRadius="{DynamicResource RadiusSmall}"
                                Background="{DynamicResource WarningBadgeBgBrush}"
                                Padding="10,6">
                            <TextBlock Text="{Binding Localizer[Operations.NoUndoNotice]}"
                                       TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource WarningBadgeFgBrush}"/>
                        </Border>

                        <!-- Empty State: Visible when no operations exist -->
                        <Border IsVisible="{Binding !HasOperationHistory}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="16">
                            <TextBlock Text="{Binding Localizer[Operations.Empty]}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </Border>

                        <!-- Virtualized Operations List: Visible when operations exist -->
                        <ListBox x:Name="OperationsListBox"
                                 ItemsSource="{Binding OperationHistory}"
                                 IsVisible="{Binding HasOperationHistory}"
                                 MaxHeight="360"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OperationItemViewModel">
                                    <Border Margin="0,0,0,6"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusSmall}"
                                            Padding="12,10">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                            <!-- Top Row: File Name, Target Space & Status Badge -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <PathIcon Data="{StaticResource IconFile}" Width="12" Height="12" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding TargetSpaceName, StringFormat='→ {0}'}"
                                                               IsVisible="{Binding TargetSpaceName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                               FontSize="13" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Status Badge & Undo Action -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button x:Name="UndoOperationButton"
                                                            Classes="ActionButton"
                                                            Content="{Binding Localizer[Operations.UndoAction]}"
                                                            Command="{Binding UndoCommand}"
                                                            IsVisible="{Binding CanUndo}"
                                                            IsEnabled="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).CanUndoManualMove}"
                                                            Cursor="Hand"/>
                                                    <Button Name="InspectOperationButton" Classes="ActionButton"
                                                            Content="{Binding Localizer[Startup.RecoveryDetails]}"
                                                            Command="{Binding $parent[UserControl].((vm:StudioViewModel)DataContext).InspectOperationCommand}"
                                                            CommandParameter="{Binding Id}" IsVisible="{Binding IsRecoveryRequired}"/>
                                                    <!-- Status Badge -->
                                                    <Border CornerRadius="{DynamicResource RadiusSmall}"
                                                            Padding="6,2"
                                                            Background="{DynamicResource SurfaceElevatedBrush}">
                                                        <TextBlock Text="{Binding StatusLocalized}"
                                                                   FontSize="13" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Paths & Timestamp -->
                                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="{Binding SourcePath, StringFormat='Source: {0}'}"
                                                               IsVisible="{Binding HasSourcePath}"
                                                               FontFamily="Consolas,Menlo,Monospace" FontSize="13"
                                                               FlowDirection="LeftToRight" Foreground="{DynamicResource TextTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DestinationPath, StringFormat='Target: {0}'}"
                                                               IsVisible="{Binding HasDestinationPath}"
                                                               FontFamily="Consolas,Menlo,Monospace" FontSize="13"
                                                               FlowDirection="LeftToRight" Foreground="{DynamicResource TextTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding FormattedCreatedAt}"
                                                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Top"/>
                                            </Grid>

                                            <!-- Status Description -->
                                            <TextBlock Grid.Row="2" Text="{Binding StatusDescription}"
                                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"/>

                                            <!-- Actionable Warning Banner for RecoveryRequired (NEVER SUCCESS) -->
                                            <Border Grid.Row="3"
                                                    IsVisible="{Binding IsRecoveryRequired}"
                                                    Margin="0,6,0,0"
                                                    Background="#20EF4444"
                                                    BorderBrush="#EF4444"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource RadiusSmall}"
                                                    Padding="8,6">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <PathIcon Grid.Column="0" Data="{StaticResource IconAlert}" Width="12" Height="12"
                                                              Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding RecoveryActionPrompt}"
                                                               TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#EF4444"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Save & Reset Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,16">
                        <Button Classes="PrimaryAction"
                                Content="{Binding Localizer[Settings.Save]}"
                                Command="{Binding SaveSettingsCommand}"
                                Padding="18,8" FontSize="14"/>

                        <Button Classes="ActionButton"
                                Content="{Binding Localizer[Settings.ResetOnboarding]}"
                                Command="{Binding ResetOnboardingCommand}"
                                Padding="16,8" FontSize="14"/>

                        <TextBlock Text="{Binding SettingsSavedFeedback}"
                                   Foreground="{DynamicResource SuccessBadgeFgBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Cross-space catalog search: selection returns to the existing file actions. -->
            <Grid IsVisible="{Binding IsWorkspaceSearchTab}" RowDefinitions="Auto,Auto,*,Auto" Margin="24,18">
                <StackPanel Spacing="6" Margin="0,0,0,16">
                    <TextBlock Text="{Binding Localizer[Search.Workspace]}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Localizer[Search.Notice]}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <TextBox Grid.Row="1" Name="WorkspaceSearchInput" Text="{Binding WorkspaceSearchText}"
                         PlaceholderText="{Binding Localizer[Files.SearchName]}" MaxLength="260" Margin="0,0,0,12"
                         AutomationProperties.Name="{Binding Localizer[Search.Workspace]}"/>
                <Grid Grid.Row="2">
                    <ListBox Name="WorkspaceSearchResultsList" ItemsSource="{Binding WorkspaceSearchResults}"
                             SelectedItem="{Binding SelectedWorkspaceResult}" Background="Transparent" BorderThickness="0">
                        <ListBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding RevealSearchResultCommand}"
                                        CommandParameter="{Binding SelectedWorkspaceResult}"/>
                        </ListBox.KeyBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkspaceSearchResult">
                                <Border Padding="10,8" DoubleTapped="OnSearchResultDoubleTapped">
                                    <ToolTip.Tip><TextBlock Text="{Binding File.Path}" FlowDirection="LeftToRight"/></ToolTip.Tip>
                                    <Grid ColumnDefinitions="24,*">
                                        <Grid VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconFolder}" IsVisible="{Binding File.IsDirectory}"
                                                      Width="16" Height="16" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            <PathIcon Data="{StaticResource IconFile}" IsVisible="{Binding !File.IsDirectory}"
                                                      Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="3" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding File.Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SpaceName}" TextTrimming="CharacterEllipsis" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Localizer[Files.NoMatches]}" IsVisible="{Binding WorkspaceSearchHasNoResults}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                    <TextBlock Text="{Binding Localizer[Search.Limit]}" IsVisible="{Binding WorkspaceSearchTruncated}"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Name="RevealSearchResultButton" Grid.Column="1" Content="{Binding Localizer[Search.ShowInSpace]}"
                            Command="{Binding RevealSearchResultCommand}" CommandParameter="{Binding SelectedWorkspaceResult}"
                            IsEnabled="{Binding HasSelectedWorkspaceResult}"/>
                </Grid>
            </Grid>

            <!-- Disabled definitions only: no runtime or automatic execution entry. -->
            <Grid IsVisible="{Binding IsFlowTab}" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24,18">
                <TextBlock Text="{Binding Localizer[Flow.Title]}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="{Binding Localizer[Flow.Notice]}" TextWrapping="Wrap" Margin="0,8,0,16"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <WrapPanel Grid.Row="2" IsEnabled="{Binding !IsFlowBusy}" Margin="0,0,0,12">
                    <Button Content="{Binding Localizer[Flow.New]}" Command="{Binding NewFlowDefinitionCommand}" Margin="0,0,8,0"/>
                    <Button Content="{Binding Localizer[Flow.Reload]}" Command="{Binding LoadFlowDefinitionsCommand}" Margin="0,0,8,0"/>
                    <Button Name="ValidateFlowButton" Content="{Binding Localizer[Flow.Validate]}" Command="{Binding ValidateFlowDefinitionCommand}" Margin="0,0,8,0"/>
                    <Button Name="SaveFlowButton" Content="{Binding Localizer[Action.Save]}" Command="{Binding SaveFlowDefinitionCommand}" Margin="0,0,8,0"/>
                    <Button Name="RunManualFlowButton" Content="{Binding Localizer[Flow.RunManual]}" Command="{Binding RunManualFlowCommand}" ToolTip.Tip="{Binding Localizer[Flow.PromptOnly]}"/>
                </WrapPanel>
                <Grid Grid.Row="3" ColumnDefinitions="180,*" ColumnSpacing="12" IsEnabled="{Binding !IsFlowBusy}">
                    <ListBox ItemsSource="{Binding FlowDefinitions}" SelectedItem="{Binding SelectedFlowDefinition}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="flow:ManualFlowDefinition">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
                        <StackPanel Spacing="4" Margin="0,0,0,8" IsVisible="{Binding IsFlowStepsView}">
                            <TextBlock Text="{Binding Localizer[Flow.Name]}"/>
                            <TextBox Name="FlowNameInput" Text="{Binding FlowNameEditor}" MaxLength="160" IsEnabled="{Binding CanEditFlowSteps}"/>
                        </StackPanel>
                        <CheckBox Grid.Row="1" Content="{Binding Localizer[Flow.AdvancedJson]}" IsChecked="{Binding IsFlowCodeView}" Margin="0,0,0,8"/>
                        <TextBox Name="FlowJsonEditor" Grid.Row="2" Text="{Binding FlowJsonDraft}" IsVisible="{Binding IsFlowCodeView}" AcceptsReturn="True" AcceptsTab="True"
                                 MaxLength="1048576" TextWrapping="NoWrap" FontFamily="Consolas, Menlo, monospace" FontSize="13"
                                 FlowDirection="LeftToRight" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Localizer[Flow.Editor]}"/>
                        <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsFlowStepsView}" IsEnabled="{Binding CanEditFlowSteps}">
                            <WrapPanel Margin="0,0,0,8">
                                <ComboBox ItemsSource="{Binding FlowStepTypes}" SelectedItem="{Binding NewFlowStepType}" Width="180" Margin="0,0,8,8">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:FlowStepType"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Name="AddFlowStepButton" Content="{Binding Localizer[Flow.AddStep]}" Command="{Binding AddFlowStepCommand}" Margin="0,0,8,8"/>
                                <Button Content="{Binding Localizer[Flow.Up]}" Command="{Binding MoveFlowStepCommand}" CommandParameter="up" IsEnabled="{Binding HasFlowStepSelection}" Margin="0,0,8,8"/>
                                <Button Content="{Binding Localizer[Flow.Down]}" Command="{Binding MoveFlowStepCommand}" CommandParameter="down" IsEnabled="{Binding HasFlowStepSelection}" Margin="0,0,8,8"/>
                                <Button Content="{Binding Localizer[Flow.RemoveStep]}" Command="{Binding RemoveFlowStepCommand}" IsEnabled="{Binding HasFlowStepSelection}" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <Grid Grid.Row="1" ColumnDefinitions="160,*" ColumnSpacing="12">
                                <ListBox Name="FlowStepsList" ItemsSource="{Binding FlowSteps}" SelectedItem="{Binding SelectedFlowStep}">
                                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:FlowStepItem"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding Localizer[Flow.AdvancedStep]}" IsVisible="{Binding FlowStepNeedsCode}" TextWrapping="Wrap"/>
                                        <StackPanel IsVisible="{Binding IsFlowMoveStep}" Spacing="5" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Localizer[Flow.SourceSpace]}"/>
                                            <ComboBox Name="FlowSourceSpacePicker" ItemsSource="{Binding AllSpaces}" SelectedItem="{Binding FlowSourceSpace}" HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SpaceItemViewModel"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="{Binding Localizer[Flow.SourceItem]}"/>
                                            <ComboBox Name="FlowSourceItemPicker" ItemsSource="{Binding FlowSourceFiles}" SelectedItem="{Binding FlowSourceFile}" HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:WorkspaceFileItemViewModel"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="{Binding Localizer[Flow.TargetSpace]}"/>
                                            <ComboBox Name="FlowTargetSpacePicker" ItemsSource="{Binding AllSpaces}" SelectedItem="{Binding FlowTargetSpace}" HorizontalAlignment="Stretch">
                                                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SpaceItemViewModel"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Name="ApplyFlowMoveSelectionButton" Content="{Binding Localizer[Flow.UseSelection]}"
                                                    Command="{Binding ApplyFlowMoveSelectionCommand}" IsEnabled="{Binding CanApplyFlowMoveSelection}"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding FlowParameters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FlowParameterEditor">
                                                    <StackPanel Spacing="4" Margin="0,0,0,10">
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding Value}" MaxLength="32768" AcceptsReturn="{Binding IsMultiline}"
                                                                 FlowDirection="{Binding ValueFlowDirection}" MaxHeight="100"
                                                                 AutomationProperties.Name="{Binding Label}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                            <TextBlock Grid.Row="2" Text="{Binding Localizer[Flow.StepHint]}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </Grid>
                </Grid>
                <TextBlock Grid.Row="4" Text="{Binding FlowNotice}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </Grid>

            <!-- ================= TAB 4: SYSTEM PROBE & DIAGNOSTICS ================= -->
            <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsProbeTab}" Margin="24,18">
                <!-- Runtime Metrics Tiles -->
                <Grid Grid.Row="0" ColumnDefinitions="*,10,*,10,*,10,*,10,*,10,*" Margin="0,0,0,12">
                    <Border Grid.Column="0" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="10,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Localizer[Probe.ItemAvalonia]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Probe.AvaloniaVersion}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="10,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Localizer[Probe.ItemOS]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Probe.OperatingSystem}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="10,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Localizer[Probe.ItemRID]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Probe.RuntimeIdentifier}" FontWeight="SemiBold" FontSize="11" FontFamily="Consolas,Menlo,Monospace" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="10,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Localizer[Probe.ItemArch]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Probe.Architecture}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="8" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="10,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Localizer[Probe.ItemDotNet]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Probe.Framework}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="10" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="10,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Localizer[Probe.ItemWorkingSet]}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Probe.WorkingSetMemory}" FontWeight="SemiBold" FontSize="11" FontFamily="Consolas,Menlo,Monospace" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Subsystem Gate Statuses -->
                <Grid Grid.Row="1" ColumnDefinitions="*,10,*,10,*" Margin="0,0,0,12">
                    <Border Grid.Column="0" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border CornerRadius="3" Background="{DynamicResource WarningBadgeBgBrush}" Padding="5,1">
                                    <TextBlock Text="PENDING P1b" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource WarningBadgeFgBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding Localizer[Probe.ItemNativeBridge]}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Probe.NativeBridgeStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border CornerRadius="3" Background="{DynamicResource SuccessBadgeBgBrush}" Padding="5,1">
                                    <TextBlock Text="VERIFIED P2" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SuccessBadgeFgBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding Localizer[Probe.CoreP2Title]}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Localizer[Probe.CoreP2Details]}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border CornerRadius="3" Background="{DynamicResource WarningBadgeBgBrush}" Padding="5,1">
                                    <TextBlock Text="PENDING P1c" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource WarningBadgeFgBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding Localizer[Probe.ItemInference]}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Probe.InferenceStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Diagnostics Console Output -->
                <Border Grid.Row="2"
                        CornerRadius="{DynamicResource RadiusSmall}"
                        Background="{DynamicResource ConsoleBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        Padding="12">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Localizer[Probe.ConsoleHeader]}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <Button Grid.Column="1"
                                    Classes="PrimaryAction"
                                    Content="{Binding Localizer[Probe.RunButton]}"
                                    Command="{Binding Probe.RunProbeCommand}"
                                    Padding="12,5" FontSize="11"/>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Probe.ProbeLogs}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Consolas,Menlo,Monospace"
                                 FontSize="11"
                                 FlowDirection="LeftToRight">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,1"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Grid>

        <Border Name="ImportConfirmationOverlay" Grid.ColumnSpan="2" IsVisible="{Binding IsImportConfirmationOpen}"
                Background="{DynamicResource AcrylicOverlayBrush}">
            <Border Width="520" Margin="24" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource AcrylicBackgroundBrush}" BorderBrush="{DynamicResource AcrylicBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusLarge}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Localizer[Triage.ImportAction]}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Localizer[Triage.ImportNotice]}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Localizer[Triage.ImportFrom]}"/>
                    <TextBox Text="{Binding ImportSourcePath, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight"/>
                    <TextBlock Text="{Binding Localizer[Triage.ImportTo]}"/>
                    <TextBox Text="{Binding ImportDestinationPath, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight"/>
                    <TextBlock Text="{Binding ImportError}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBadgeFgBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{Binding Localizer[Action.Cancel]}" Command="{Binding CloseImportConfirmationCommand}"
                                IsEnabled="{Binding !IsImportBusy}"/>
                        <Button Classes="PrimaryAction" Content="{Binding Localizer[Triage.ImportAction]}" Command="{Binding ConfirmImportCommand}"
                                IsEnabled="{Binding !IsImportBusy}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Per-step acknowledgement; file moves show exact read-only paths before Core execution. -->
        <Border Name="FlowPromptOverlay" Grid.ColumnSpan="2" IsVisible="{Binding IsFlowPromptOpen}"
                Background="{DynamicResource AcrylicOverlayBrush}">
            <Border Width="520" MaxHeight="540" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource AcrylicBackgroundBrush}" BorderBrush="{DynamicResource AcrylicBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusLarge}">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
                    <TextBlock Text="{Binding Localizer[Flow.RunningManual]}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Text="{Binding FlowPromptTitle}" TextWrapping="Wrap" FontSize="18"/>
                    <ScrollViewer Grid.Row="2" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding FlowPromptMessage}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" IsVisible="{Binding IsFlowMoveConfirmation}" Spacing="4">
                        <TextBlock Text="{Binding Localizer[Triage.ImportFrom]}"/>
                        <TextBox Name="FlowMoveSourceInput" Text="{Binding FlowMoveSource, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{Binding Localizer[Triage.ImportTo]}"/>
                        <TextBox Name="FlowMoveDestinationInput" Text="{Binding FlowMoveDestination, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Name="CancelFlowPromptButton" Content="{Binding Localizer[Action.Cancel]}"
                                Command="{Binding RunManualFlowCancelCommand}" IsCancel="{Binding IsFlowPromptOpen}"/>
                        <Button Name="AcknowledgeFlowPromptButton" Content="{Binding FlowPromptActionText}"
                                Command="{Binding AcknowledgeFlowPromptCommand}" IsDefault="{Binding IsFlowPromptOpen}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Explicit model-data removal; never reuse user-file deletion commands. -->
        <Border Name="ModelRemovalOverlay" Grid.ColumnSpan="2" IsVisible="{Binding IsModelRemovalOpen}"
                Background="{DynamicResource AcrylicOverlayBrush}">
            <Border Width="540" MaxHeight="600" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource AcrylicBackgroundBrush}" BorderBrush="{DynamicResource AcrylicBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusLarge}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Localizer[Classification.RemoveModelData]}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Localizer[Classification.ModelRemovalNotice]}" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding ModelRemovalDirectory, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight"/>
                    <TextBox Text="{Binding ModelRemovalFiles, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             Height="160" FlowDirection="LeftToRight" FontFamily="Consolas,Menlo,Monospace"/>
                    <TextBlock Text="{Binding ModelRemovalError}" TextWrapping="Wrap" Foreground="{DynamicResource AccentTextBrush}"/>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsModelRemovalBusy}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{Binding Localizer[Action.Cancel]}" Command="{Binding CloseModelRemovalCommand}" IsEnabled="{Binding !IsModelRemovalBusy}"/>
                        <Button Content="{Binding Localizer[Classification.RemoveModelData]}" Command="{Binding ConfirmModelRemovalCommand}" IsEnabled="{Binding !IsModelRemovalBusy}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ADD SPACE DIALOG MODAL -->
        <Border Grid.Column="0" Grid.ColumnSpan="2"
                IsVisible="{Binding IsAddSpaceDialogOpen}"
                Background="{DynamicResource AcrylicOverlayBrush}">
            <Border Background="{DynamicResource AcrylicBackgroundBrush}"
                    BorderBrush="{DynamicResource AcrylicBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLarge}"
                    Padding="22"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding SpaceDialogTitle}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Localizer[Spaces.EditNotice]}" IsVisible="{Binding IsEditingSpace}"
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Localizer[Spaces.DialogName]}" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding NewSpaceName}" MaxLength="160" CornerRadius="{DynamicResource RadiusSmall}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Localizer[Spaces.DialogDesc]}" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding NewSpaceDesc}" MaxLength="1000" CornerRadius="{DynamicResource RadiusSmall}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Localizer[Spaces.DialogMode]}" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="20" IsEnabled="{Binding !IsEditingSpace}">
                            <RadioButton Name="NewSpaceManagedMode" GroupName="NewSpaceMode"
                                         Content="{Binding Localizer[Spaces.BadgeManaged]}"
                                         IsChecked="{Binding IsNewSpaceManaged}"/>
                            <RadioButton Name="NewSpaceMappedMode" GroupName="NewSpaceMode"
                                         Content="{Binding Localizer[Spaces.BadgeMapped]}"
                                         IsChecked="{Binding IsNewSpaceMapped}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Localizer[Spaces.DialogFolder]}" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Name="NewSpaceFolderInput" Text="{Binding NewSpaceFolder}"
                                     IsReadOnly="{Binding IsSpaceFolderReadOnly}"
                                     AutomationProperties.Name="{Binding Localizer[Spaces.DialogFolder]}"
                                     FontFamily="Consolas,Menlo,Monospace" FlowDirection="LeftToRight"
                                     CornerRadius="{DynamicResource RadiusSmall}" FontSize="11"/>
                            <Button Name="BrowseSpaceFolderButton" Grid.Column="1" Margin="8,0,0,0"
                                    Content="{Binding Localizer[Action.Browse]}" IsVisible="{Binding IsNewSpaceMapped}"
                                    IsEnabled="{Binding !IsEditingSpace}" Click="OnBrowseSpaceFolderClick"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="{Binding SpaceDialogError}" Foreground="{DynamicResource WarningBadgeFgBrush}" FontSize="11"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Classes="ActionButton"
                                Content="{Binding Localizer[Action.Cancel]}"
                                Command="{Binding CloseAddSpaceDialogCommand}"
                                HotKey="Escape"
                                Padding="12,6"/>
                        <Button Classes="PrimaryAction"
                                Content="{Binding SpaceDialogConfirmText}"
                                Command="{Binding ConfirmAddSpaceCommand}"
                                HotKey="Enter"
                                Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- CREATE SPACE FROM TRIAGE MODAL -->
        <Border Grid.Column="0" Grid.ColumnSpan="2"
                IsVisible="{Binding IsCreateSpaceFromTriageOpen}"
                Background="{DynamicResource AcrylicOverlayBrush}">
            <Border Background="{DynamicResource AcrylicBackgroundBrush}"
                    BorderBrush="{DynamicResource AcrylicBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLarge}"
                    Padding="22"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Localizer[Triage.NewSpaceModalTitle]}" FontSize="15" FontWeight="SemiBold"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Localizer[Spaces.DialogName]}" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding TriageNewSpaceName}" CornerRadius="{DynamicResource RadiusSmall}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Localizer[Spaces.DialogDesc]}" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding TriageNewSpaceDesc}" CornerRadius="{DynamicResource RadiusSmall}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                        <Button Classes="ActionButton"
                                Content="{Binding Localizer[Action.Cancel]}"
                                Command="{Binding CloseCreateSpaceFromTriageCommand}"
                                HotKey="Escape"
                                Padding="12,5"/>
                        <Button Classes="PrimaryAction"
                                Content="{Binding Localizer[Triage.NewSpaceModalConfirm]}"
                                Command="{Binding ConfirmCreateSpaceFromTriageCommand}"
                                HotKey="Enter"
                                Padding="14,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- RENAME FILE MODAL -->
        <Border Grid.Column="0" Grid.ColumnSpan="2"
                IsVisible="{Binding IsRenameDialogOpen}"
                Background="{DynamicResource AcrylicOverlayBrush}">
            <Border Background="{DynamicResource AcrylicBackgroundBrush}"
                    BorderBrush="{DynamicResource AcrylicBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLarge}"
                    Padding="22"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding Localizer[Files.RenameModalTitle]}" FontSize="16" FontWeight="SemiBold"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Localizer[Files.RenameModalPrompt]}" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Name="RenameNameInput" Text="{Binding RenameItemName}" CornerRadius="{DynamicResource RadiusSmall}" FontSize="12"/>
                    </StackPanel>

                    <TextBlock Text="{Binding RenameDialogError}" Foreground="{DynamicResource WarningBadgeFgBrush}" FontSize="11"
                               IsVisible="{Binding RenameDialogError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Classes="ActionButton"
                                Content="{Binding Localizer[Action.Cancel]}"
                                Command="{Binding CloseRenameDialogCommand}"
                                HotKey="Escape"
                                Padding="12,6"/>
                        <Button Classes="PrimaryAction"
                                Content="{Binding Localizer[Files.ActionRename]}"
                                Command="{Binding ConfirmRenameCommand}"
                                HotKey="Enter"
                                Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- DELETE / RECOVERY CONFIRMATION MODAL -->
        <Border x:Name="DeleteConfirmationOverlay"
                Grid.Column="0" Grid.ColumnSpan="2"
                IsVisible="{Binding IsDeleteConfirmationDialogOpen}"
                Background="{DynamicResource AcrylicOverlayBrush}">
            <Border Background="{DynamicResource AcrylicBackgroundBrush}"
                    BorderBrush="{DynamicResource AcrylicBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLarge}"
                    Padding="22"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding DeleteConfirmTitleText}" FontSize="16" FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding DeleteConfirmPromptText}"
                               TextWrapping="Wrap" FontSize="12" LineHeight="18"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock Text="{Binding DeleteConfirmationDialogError}" Foreground="{DynamicResource WarningBadgeFgBrush}" FontSize="11"
                               IsVisible="{Binding DeleteConfirmationDialogError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="DeleteConfirmationCancelButton"
                                Classes="ActionButton"
                                Content="{Binding Localizer[Action.Cancel]}"
                                Command="{Binding CloseDeleteConfirmationDialogCommand}"
                                IsEnabled="{Binding !IsDeleteConfirmationBusy}"
                                HotKey="Escape"
                                Padding="12,6"/>
                        <Button x:Name="DeleteConfirmationConfirmButton"
                                Classes="PrimaryAction"
                                Content="{Binding DeleteConfirmActionText}"
                                Command="{Binding ConfirmDeleteFileCommand}"
                                IsEnabled="{Binding !IsDeleteConfirmationBusy}"
                                HotKey="Enter"
                                Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- FILE PREVIEW MODAL -->
        <Border x:Name="FilePreviewOverlay"
                Grid.Column="0" Grid.ColumnSpan="2"
                IsVisible="{Binding IsPreviewDialogOpen}"
                Background="{DynamicResource AcrylicOverlayBrush}">
            <Border Background="{DynamicResource AcrylicBackgroundBrush}"
                    BorderBrush="{DynamicResource AcrylicBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLarge}"
                    Padding="22"
                    Width="540"
                    MaxHeight="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding Localizer[Files.PreviewDialogTitle]}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PreviewFileName}" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Top"
                                Background="{DynamicResource SurfaceSubtleBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSmall}" Padding="6,2">
                            <TextBlock Text="{Binding PreviewKind}" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontWeight="Medium"/>
                        </Border>
                    </Grid>

                    <!-- Metadata / Summary notice -->
                    <TextBlock Grid.Row="1" Text="{Binding PreviewDetails}"
                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,0,0,8"
                               IsVisible="{Binding PreviewDetails, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- Bounded Content Area -->
                    <Border Grid.Row="2" Background="{DynamicResource ConsoleBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="8" MinHeight="160" MaxHeight="300">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding PreviewContent}"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas,Menlo,Monospace"
                                     FontSize="11"
                                     FlowDirection="LeftToRight"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Truncated notice banner -->
                    <Border Grid.Row="3" Margin="0,8,0,0"
                            IsVisible="{Binding IsPreviewTruncated}"
                            Background="{DynamicResource WarningBadgeBgBrush}"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="8,4">
                        <TextBlock Text="{Binding Localizer[Files.PreviewTruncatedNotice]}"
                                   Foreground="{DynamicResource WarningBadgeFgBrush}"
                                   FontSize="11"/>
                    </Border>

                    <!-- Footer / Dismiss Button -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
                        <Button x:Name="FilePreviewCloseButton"
                                Classes="ActionButton"
                                Content="{Binding Localizer[Action.Close]}"
                                Command="{Binding ClosePreviewDialogCommand}"
                                HotKey="Escape"
                                Padding="14,5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
