<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskNest.App.ViewModels"
        xmlns:views="using:DeskNest.App.Views"
        xmlns:loc="using:DeskNest.App.Localization"
        xmlns:th="using:DeskNest.App.Themes"
        x:Class="DeskNest.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Localizer[App.Title]}"
        Width="1280" Height="760"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FlowDirection="{Binding CurrentFlowDirection}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Brand & Slogan -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="36" Height="36"
                            CornerRadius="{DynamicResource RadiusPrimary}"
                            Background="{DynamicResource AccentPrimaryBrush}">
                        <TextBlock Text="栖"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Localizer[App.Title]}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <Border CornerRadius="{DynamicResource RadiusPrimary}"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    BorderBrush="{DynamicResource AccentBorderBrush}"
                                    BorderThickness="1"
                                    Padding="6,2">
                                <TextBlock Text="{Binding Localizer[App.ProbeTagP2]}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Slogan -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Localizer[App.Tagline]}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Localizer[App.TaglineDraftNotice]}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Controls: Theme and Language -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <!-- Theme Selector -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localizer[Theme.Label]}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding SupportedThemes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  CornerRadius="{DynamicResource RadiusPrimary}"
                                  Width="110">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="th:AppThemeMode">
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Language Selector -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localizer[Language.Label]}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding SupportedLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  CornerRadius="{DynamicResource RadiusPrimary}"
                                  Width="180">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="loc:LanguageInfo">
                                    <TextBlock Text="{Binding DisplayText}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1">
            <!-- 1. Loading View -->
            <Border IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="✦" FontSize="32" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Localizer[Status.Loading]}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 2. Startup Error View (Visible fail-closed without overwriting metadata) -->
            <Border IsVisible="{Binding HasStartupError}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" MaxWidth="680">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBadgeFgBrush}"
                        BorderThickness="2"
                        CornerRadius="{DynamicResource RadiusLarge}"
                        Padding="32">
                    <StackPanel Spacing="16">
                        <!-- Icon & Title -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource WarningBadgeBgBrush}">
                                <TextBlock Text="⚠" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBadgeFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Localizer[Startup.Error.Title]}" FontWeight="Bold" FontSize="18"/>
                                <TextBlock Text="{Binding Localizer[Startup.Error.Subtitle]}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Lock error specifics -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsLockConflict}">
                            <TextBlock Text="{Binding Localizer[Startup.LockError.Title]}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource WarningBadgeFgBrush}"/>
                            <TextBlock Text="{Binding Localizer[Startup.LockError.Message]}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Recovery error specifics -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsRecoveryRequired}">
                            <TextBlock Text="{Binding Localizer[Startup.RecoveryError.Title]}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource WarningBadgeFgBrush}"/>
                            <TextBlock Text="{Binding Localizer[Startup.RecoveryError.Message]}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Diagnostic details box -->
                        <Border Background="{DynamicResource ConsoleBackgroundBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="12,10">
                            <TextBlock Text="{Binding StartupErrorMessage}"
                                       FontFamily="Consolas,Menlo,Monospace"
                                       FontSize="11"
                                       FlowDirection="LeftToRight"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Error Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
                            <Button Content="{Binding Localizer[Action.OpenDataFolder]}"
                                    Command="{Binding OpenDataFolderCommand}"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Padding="14,8"/>
                            <Button Content="{Binding Localizer[Action.Exit]}"
                                    Command="{Binding ExitApplicationCommand}"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Padding="14,8"/>
                            <Button Content="{Binding Localizer[Action.Retry]}"
                                    Command="{Binding RetryStartupCommand}"
                                    Background="{DynamicResource AccentPrimaryBrush}"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Padding="16,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- 3. Onboarding Wizard View -->
            <Panel IsVisible="{Binding IsOnboardingActive}">
                <views:OnboardingView DataContext="{Binding Onboarding}"/>
            </Panel>

            <!-- 4. Studio View -->
            <Panel IsVisible="{Binding IsStudioActive}">
                <views:StudioView DataContext="{Binding Studio}"/>
            </Panel>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Status Left -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding StatusDotColor}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusTitleText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="|" Foreground="{DynamicResource BorderSubtleBrush}"/>
                    <TextBlock Text="{Binding StatusNoticeText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <!-- Status Right -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Probe.RuntimeIdentifier}"
                               FontFamily="Consolas,Menlo,Monospace"
                               FontSize="11"
                               FlowDirection="LeftToRight"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Probe.WorkingSetMemory}"
                               FontFamily="Consolas,Menlo,Monospace"
                               FontSize="11"
                               FlowDirection="LeftToRight"
                               Foreground="{DynamicResource AccentTextBrush}"/>
                    <TextBlock Text="{Binding CurrentFlowDirection}"
                               FontFamily="Consolas,Menlo,Monospace"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
