<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskNest.App.ViewModels"
        xmlns:views="using:DeskNest.App.Views"
        xmlns:loc="using:DeskNest.App.Localization"
        xmlns:th="using:DeskNest.App.Themes"
        x:Class="DeskNest.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DeskNext"
        Width="1280" Height="760"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="False"
        CanResize="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FlowDirection="{Binding CurrentFlowDirection}">

    <Border x:Name="WindowFrame"
            CornerRadius="{DynamicResource RadiusWindow}"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- COMPACT APPLICATION CHROME (Window Title Bar & Global Utility) -->
        <Border Grid.Row="0"
                Height="38"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                DoubleTapped="OnTitleBarDoubleTapped"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="9"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <PathIcon Data="{StaticResource IconDeskNext}"
                              Width="21" Height="21"
                              Foreground="{DynamicResource AccentPrimaryBrush}"/>
                    <TextBlock Text="DeskNext"
                               FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Panel Grid.Column="1" Background="Transparent"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Classes="WindowChromeButton"
                            Click="OnMinimizeWindowClick"
                            Focusable="False">
                        <PathIcon Data="{StaticResource IconChromeMinimize}"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Classes="WindowChromeButton"
                            Click="OnMaximizeRestoreWindowClick"
                            Focusable="False">
                        <PathIcon x:Name="MaximizeIcon"
                                  Data="{StaticResource IconChromeMaximize}"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Classes="WindowChromeButton CloseButton"
                            Click="OnCloseWindowClick"
                            ToolTip.Tip="{Binding Localizer[Action.Close]}"
                            Focusable="False">
                        <PathIcon Data="{StaticResource IconChromeClose}"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1">
            <!-- 1. Loading View -->
            <Border IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <Border Width="24" Height="24"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            BorderBrush="{DynamicResource AccentPrimaryBrush}"
                            BorderThickness="2"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Localizer[Status.Loading]}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 2. Startup Error View (Visible fail-closed without overwriting metadata) -->
            <ScrollViewer IsVisible="{Binding HasStartupError}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Padding="24" MaxWidth="760" VerticalScrollBarVisibility="Auto">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBadgeFgBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusLarge}"
                        Padding="28">
                    <StackPanel Spacing="16">
                        <!-- Icon & Title -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="36" Height="36" CornerRadius="{DynamicResource RadiusSmall}"
                                    Background="{DynamicResource WarningBadgeBgBrush}"
                                    BorderBrush="{DynamicResource WarningBadgeFgBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="!" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WarningBadgeFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Localizer[Startup.Error.Title]}" FontWeight="Bold" FontSize="17"/>
                                <TextBlock Text="{Binding Localizer[Startup.Error.Subtitle]}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Lock error specifics -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsLockConflict}">
                            <TextBlock Text="{Binding Localizer[Startup.LockError.Title]}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource WarningBadgeFgBrush}"/>
                            <TextBlock Text="{Binding Localizer[Startup.LockError.Message]}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Recovery error specifics -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsRecoveryRequired}">
                            <TextBlock Text="{Binding Localizer[Startup.RecoveryError.Title]}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource WarningBadgeFgBrush}"/>
                            <TextBlock Text="{Binding Localizer[Startup.RecoveryError.Message]}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Diagnostic details box -->
                        <Border Background="{DynamicResource ConsoleBackgroundBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="12,10">
                            <TextBlock Text="{Binding StartupErrorMessage}"
                                       FontFamily="Consolas,Menlo,Monospace"
                                       FontSize="11"
                                       FlowDirection="LeftToRight"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <StackPanel Spacing="8" IsVisible="{Binding IsRecoveryRequired}">
                            <Button Content="{Binding Localizer[Startup.RecoveryDetails]}"
                                    Command="{Binding InspectRecoveryEvidenceCommand}"/>
                            <TextBlock Text="{Binding Localizer[Startup.RecoveryDetailsNotice]}"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="RecoveryEvidenceTextBox" Text="{Binding RecoveryEvidenceText, Mode=OneWay}"
                                     IsVisible="{Binding HasRecoveryEvidence}" IsReadOnly="True" AcceptsReturn="True"
                                     Height="180" TextWrapping="NoWrap" FontFamily="Consolas,Menlo,Monospace"
                                     FontSize="12" FlowDirection="LeftToRight"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="{Binding Localizer[Startup.RecoveryDetails]}"/>
                        </StackPanel>

                        <!-- Error Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
                            <Button Content="{Binding Localizer[Action.OpenDataFolder]}"
                                    Command="{Binding OpenDataFolderCommand}"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Padding="14,8"/>
                            <Button Content="{Binding Localizer[Action.Exit]}"
                                    Command="{Binding ExitApplicationCommand}"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Padding="14,8"/>
                            <Button Content="{Binding Localizer[Action.Retry]}"
                                    Command="{Binding RetryStartupCommand}"
                                    Background="{DynamicResource AccentPrimaryBrush}"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    CornerRadius="{DynamicResource RadiusSmall}"
                                    Padding="16,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- 3. Onboarding Wizard View -->
            <Panel IsVisible="{Binding IsOnboardingActive}">
                <views:OnboardingView DataContext="{Binding Onboarding}"/>
            </Panel>

            <!-- 4. Studio View -->
            <Panel IsVisible="{Binding IsStudioActive}">
                <views:StudioView DataContext="{Binding Studio}"/>
            </Panel>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2"
                Height="28"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,4">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="3.5" Background="{Binding StatusDotColor}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusTitleText}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding StatusNoticeText}"
                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
