<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskNest.App.ViewModels"
        xmlns:views="using:DeskNest.App.Views"
        x:Class="DeskNest.App.Views.DropCapsuleWindow"
        x:DataType="vm:DropCapsuleViewModel"
        Title="DeskNext" Topmost="False" Width="300" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen" WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="False"
        Background="Transparent" TransparencyLevelHint="AcrylicBlur, Mica, None"
        TransparencyBackgroundFallback="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FlowDirection="{Binding CurrentFlowDirection}">
    <Border Margin="0" CornerRadius="{DynamicResource RadiusWindow}" Background="{DynamicResource CompanionMaterialBrush}"
            BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" Padding="14,10">
        <StackPanel Spacing="4">
            <Border x:Name="DropCapsuleBorder" DragDrop.AllowDrop="True" Background="Transparent"
                    CornerRadius="4" Padding="2,4" PointerPressed="OnTitleBarPointerPressed"
                    ToolTip.Tip="{Binding Localizer[Capsule.Notice]}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Localizer[Icons.Change]}" Click="OnChangeIconClick" IsEnabled="{Binding CanCustomizeIcon}"
                                  ToolTip.Tip="{Binding Localizer[Icons.LocalOnly]}"/>
                        <MenuItem Header="{Binding Localizer[Icons.Reset]}" Click="OnResetIconClick" IsEnabled="{Binding HasCustomIcon}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentSubtleBrush}">
                        <Grid>
                            <PathIcon Data="{StaticResource IconInbox}" Width="17" Height="17" IsVisible="{Binding !HasCustomIcon}"
                                      Foreground="{DynamicResource AccentTextBrush}"/>
                            <views:FileIcon IsDirectory="True" CustomIconPath="{Binding CustomIconPath}" Width="24" Height="24" IsVisible="{Binding HasCustomIcon}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding Localizer[Capsule.Title]}" FontSize="13" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Localizer[Drop.CapsuleTargetHint]}" IsVisible="{Binding IsDragOverCapsule}"
                                   FontSize="11" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="WindowChromeButton CloseButton" Width="24" Height="24"
                            VerticalAlignment="Center" Click="OnCloseButtonClick"
                            ToolTip.Tip="{Binding Localizer[Action.Close]}"
                            AutomationProperties.Name="{Binding Localizer[Action.Close]}">
                        <PathIcon Data="{StaticResource IconChromeClose}" Width="9" Height="9"/>
                    </Button>
                </Grid>
            </Border>
            <TextBlock Text="{Binding CapsuleNotice}" IsVisible="{Binding HasCapsuleNotice}" TextWrapping="Wrap"
                       Margin="2,4" FontSize="12" Foreground="{DynamicResource AccentTextBrush}"/>
            <ToggleButton IsChecked="{Binding #CapsuleManualEntry.IsVisible, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0" Padding="2,2" MinHeight="22"
                          HorizontalAlignment="Left" FontSize="11"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Content="{Binding Localizer[Capsule.ManualEntry]}"/>
            <Grid Name="CapsuleManualEntry" IsVisible="False" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,4,0,2">
                <TextBox Text="{Binding CapsuleInputPath}" PlaceholderText="{Binding Localizer[Capsule.Placeholder]}"
                         FontSize="12" FlowDirection="LeftToRight"/>
                <Button Grid.Column="1" Classes="PrimaryAction" Content="{Binding Localizer[Capsule.Submit]}"
                        Command="{Binding SubmitCapsuleCommand}" Padding="10,6"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
